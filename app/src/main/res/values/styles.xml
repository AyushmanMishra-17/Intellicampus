<?xml version="1.0" encoding="utf-8"?>
<resources>


    <!-- Typography                -->


    <style name="TextAppearance.IntelliCampus.Display"
        parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.IntelliCampus.Headline"
        parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.IntelliCampus.Title"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.IntelliCampus.Body"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.IntelliCampus.Caption"
        parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.IntelliCampus.Label"
        parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Material Cards            -->

    <style name="Widget.IntelliCampus.Card"
        parent="Widget.Material3.CardView.Elevated">

        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>

    </style>

    <style name="Widget.IntelliCampus.OutlinedCard"
        parent="Widget.Material3.CardView.Outlined">

        <item name="cardCornerRadius">@dimen/card_radius</item>

    </style>
</resources>