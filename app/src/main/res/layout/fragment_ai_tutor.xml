<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ai_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR STUDY COMPANION"
                android:textColor="@color/ai_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="AI Tutor"
                android:textColor="@color/ai_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTutorContext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Loading your syllabus..."
                android:textColor="@color/ai_text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTutorHistory"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_ai_icon_button"
            android:contentDescription="Chat history"
            android:padding="10dp"
            android:src="@drawable/ic_schedule"
            app:tint="@color/ai_text_primary"/>

        <ImageButton
            android:id="@+id/btnTutorNewChat"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_ai_icon_button"
            android:contentDescription="New chat"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            app:tint="@color/ai_text_primary"/>

        <ImageButton
            android:id="@+id/btnTutorSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_ai_icon_button"
            android:contentDescription="AI Tutor settings"
            android:padding="10dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/ai_text_primary"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="START WITH A SHORTCUT"
            android:textColor="@color/ai_hint"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExplain"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Explain"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/ai_text_primary"
                app:strokeColor="@color/ai_border"
                app:cornerRadius="13dp"
                app:icon="@drawable/ic_menu_book"
                app:iconGravity="textStart"
                app:iconTint="@color/ai_accent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSummarize"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Summarize"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/ai_text_primary"
                app:strokeColor="@color/ai_border"
                app:cornerRadius="13dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuiz"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Quiz me"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/ai_text_primary"
                app:strokeColor="@color/ai_border"
                app:cornerRadius="13dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStudyPlan"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Study plan"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/ai_text_primary"
                app:strokeColor="@color/ai_border"
                app:cornerRadius="13dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:background="@color/ai_surface">

        <EditText
            android:id="@+id/etTutorMessage"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ai_input"
            android:hint="Ask anything about your syllabus..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ai_text_primary"
            android:textColorHint="@color/ai_hint"
            android:textSize="14sp"/>

        <ImageButton
            android:id="@+id/btnSendTutor"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_ai_send"
            android:contentDescription="Send message"
            android:padding="14dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/white"/>
    </LinearLayout>
</LinearLayout>
