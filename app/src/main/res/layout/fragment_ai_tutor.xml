<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ai_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Tutor"
                android:textColor="@color/ai_text_primary"
                android:textSize="27sp"
                android:textStyle="bold"
                android:paddingTop="25dp"/>

            <TextView
                android:id="@+id/tvTutorContext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Loading your syllabus..."
                android:textColor="@color/ai_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTutorHistory"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_ai_icon_button"
            android:contentDescription="Chat history"
            android:padding="10dp"
            android:src="@drawable/ic_schedule"
            app:tint="@color/ai_text_primary" />

        <ImageButton
            android:id="@+id/btnTutorNewChat"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_ai_icon_button"
            android:contentDescription="New chat"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            app:tint="@color/ai_text_primary" />

        <ImageButton
            android:id="@+id/btnTutorSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_ai_icon_button"
            android:contentDescription="AI Tutor settings"
            android:padding="10dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/ai_text_primary" />
    </LinearLayout>

    <!-- Quick actions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:text="Quick actions"
        android:textColor="@color/ai_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExplain"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Explain"
                android:textAllCaps="false"
                android:textColor="@color/ai_text_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/ai_action_blue"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_menu_book"
                app:iconGravity="textStart"
                app:iconTint="@color/ai_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSummarize"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Summarize"
                android:textAllCaps="false"
                android:textColor="@color/ai_text_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/ai_action_blue"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuiz"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Quiz Me"
                android:textAllCaps="false"
                android:textColor="@color/ai_text_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/ai_action_blue"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStudyPlan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Study Plan"
                android:textAllCaps="false"
                android:textColor="@color/ai_text_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/ai_action_blue"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Conversation -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/etTutorMessage"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ai_input"
            android:hint="Ask about your syllabus..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/ai_text_primary"
            android:textColorHint="@color/ai_hint"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSendTutor"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_ai_send"
            android:contentDescription="Send"
            android:padding="15dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@android:color/white" />
    </LinearLayout>

</LinearLayout>
