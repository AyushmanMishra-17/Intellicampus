<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <include
            android:id="@+id/headerLayout"
            layout="@layout/layout_home_header" />

        <include
            android:id="@+id/overviewLayout"
            layout="@layout/layout_home_overview" />

        <include
            android:id="@+id/scheduleLayout"
            layout="@layout/layout_home_schedule" />

        <include
            android:id="@+id/quickActionsLayout"
            layout="@layout/layout_home_quick_actions" />

        <include
            android:id="@+id/noticeLayout"
            layout="@layout/layout_home_notice" />

        <include
            android:id="@+id/assignmentLayout"
            layout="@layout/layout_home_assignment" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>