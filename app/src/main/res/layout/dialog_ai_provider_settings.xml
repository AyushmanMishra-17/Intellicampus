<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/ai_surface"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose the service that powers your AI Tutor. Your key stays encrypted on this device."
            android:textColor="@color/ai_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI PROVIDER"
            android:textColor="@color/ai_accent"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <Spinner
            android:id="@+id/spinnerAiProvider"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_ai_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:popupBackground="@color/ai_surface_2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODEL ID"
            android:textColor="@color/ai_accent"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/etAiModel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_ai_input"
            android:hint="e.g. gpt-4.1-mini"
            android:inputType="textNoSuggestions"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ai_text_primary"
            android:textColorHint="@color/ai_hint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API KEY"
            android:textColor="@color/ai_accent"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/etAiApiKey"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_ai_input"
            android:hint="Paste your personal API key"
            android:inputType="textPassword|textNoSuggestions"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ai_text_primary"
            android:textColorHint="@color/ai_hint"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAiBaseUrlLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API BASE URL"
            android:textColor="@color/ai_accent"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/etAiBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_ai_input"
            android:hint="https://your-provider.com/v1"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ai_text_primary"
            android:textColorHint="@color/ai_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnRemoveAiConfig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Remove saved API configuration"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supports FreeLLMAPI and providers that expose the OpenAI-compatible Chat Completions API. Custom endpoints must use HTTPS. Provider usage charges and limits may apply."
            android:textColor="@color/ai_hint"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
